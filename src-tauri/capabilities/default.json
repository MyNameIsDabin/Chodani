{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for the Chodani window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-toggle-maximize",
    "core:webview:allow-internal-toggle-devtools",
    "dialog:default",
    "updater:default"
  ]
}
